<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Forum Dyskusyjne</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>

    <!-- Pasek nawigacji -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <!-- Logo po lewej -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Forum Dyskusyjne</a>

                <!-- Elementy menu -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- Linki po lewej stronie -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Forum" asp-action="Index">Fora</a>
                        </li>
                    </ul>

                    <!-- Linki po prawej stronie -->
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning" asp-controller="Admin" asp-action="Index">Panel Admina</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                    Profil (@User.Identity.Name)
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link border-0">Wyloguj</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Zaloguj</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Zarejestruj</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Główny kontener na treść podstron -->
    <main role="main" class="container my-4">
        @RenderBody()
    </main>

    <!-- Stopka przyklejona do dołu ekranu -->
    <footer class="container border-top py-3 text-muted">
        <div class="container">
            @DateTime.Now.Year - Forum Dyskusyjne
        </div>
    </footer>

    <!-- Skrypty JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
