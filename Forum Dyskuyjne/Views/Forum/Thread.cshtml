@model ThreadDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

@* --- Nagłówek wątku ---------------------------------------------------- *@
<header class="thread-header">
    <div class="thread-breadcrumbs">
        <a asp-action="Index">Kategorie i fora</a>
        <span class="mx-1">/</span>
        <a asp-action="Threads" asp-route-forumId="@Model.ForumId">@Model.ForumName</a>
    </div>

    <h1>
        @Model.Title
        @if (Model.IsPinned)
        {
            <span class="badge-pinned"><i class="bi bi-pin-angle-fill me-1"></i>Przyklejony</span>
        }
    </h1>

    <div class="meta-line">
        <i class="bi bi-person me-1"></i>@Model.AuthorName
        <span class="mx-1">&middot;</span>
        <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
        <span class="mx-1">&middot;</span>
        <i class="bi bi-folder2 me-1"></i>@Model.CategoryName
    </div>

    <div class="thread-counters">
        <span><i class="bi bi-eye"></i><strong>@Model.ViewCount</strong> odsłon</span>
        <span><i class="bi bi-chat-dots"></i><strong>@Model.ReplyCount</strong> odpowiedzi</span>
        @if (Model.TotalPages > 1)
        {
            <span><i class="bi bi-files"></i>strona @Model.Page z @Model.TotalPages</span>
        }
    </div>
</header>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-site" role="alert">
        <i class="bi bi-check-circle me-1"></i>@successMessage
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-site" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
    </div>
}

@* --- Wiadomość inicjująca --------------------------------------------- *@
<article class="message-card is-initial">
    <div class="row g-0">
        <div class="col-auto author-panel">
            <span class="user-avatar-lg">@(string.IsNullOrEmpty(Model.AuthorName) ? "?" : Model.AuthorName.Substring(0, 1).ToUpper())</span>
            <div>
                <div class="author-name">@Model.AuthorName</div>
                <span class="badge-role">@Model.AuthorRank</span>
            </div>
            <ul class="author-facts d-none d-md-block">
                <li><i class="bi bi-chat-left-text me-1"></i>autor wątku</li>
                @if (Model.AuthorJoinedAt != DateTime.MinValue)
                {
                    <li><i class="bi bi-calendar3 me-1"></i>od @Model.AuthorJoinedAt.ToString("dd.MM.yyyy")</li>
                }
            </ul>
        </div>
        <div class="col message-body">
            <p class="message-text">@Model.Content</p>
        </div>
    </div>
    <div class="message-footer">
        <span><i class="bi bi-clock me-1"></i>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
        @* Edycja treści inicjującej (EditThread) — etap 2, gdy ustalone będą uprawnienia serwerowe. *@
    </div>
</article>

@* --- Odpowiedzi -------------------------------------------------------- *@
@{
    var pager = new PaginationViewModel
    {
        Action = "Thread",
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        RouteValues = new Dictionary<string, string> { ["id"] = Model.Id.ToString() }
    };
}

@foreach (var message in Model.Messages)
{
    <article class="message-card" id="msg-@message.Id">
        <div class="row g-0">
            <div class="col-auto author-panel">
                <span class="user-avatar-lg">@(string.IsNullOrEmpty(message.AuthorName) ? "?" : message.AuthorName.Substring(0, 1).ToUpper())</span>
                <div>
                    <div class="author-name">@message.AuthorName</div>
                    <span class="badge-role">@message.AuthorRank</span>
                </div>
                <ul class="author-facts d-none d-md-block">
                    <li><i class="bi bi-envelope me-1"></i>@message.AuthorMessageCount wiadomości</li>
                    @if (message.AuthorJoinedAt != DateTime.MinValue)
                    {
                        <li><i class="bi bi-calendar3 me-1"></i>od @message.AuthorJoinedAt.ToString("dd.MM.yyyy")</li>
                    }
                </ul>
            </div>
            <div class="col message-body">
                <p class="message-text">@message.Content</p>
                @if (message.EditedAt is not null)
                {
                    <span class="message-edited">
                        (edytowano @message.EditedAt.Value.ToString("dd.MM.yyyy HH:mm"))
                    </span>
                }
            </div>
        </div>
        <div class="message-footer">
            <span><i class="bi bi-clock me-1"></i>@message.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
            <span class="message-actions">
                <a class="btn btn-outline-accent btn-xs" data-mod-only style="display:none"
                   asp-action="EditMessage" asp-route-id="@message.Id">
                    <i class="bi bi-pencil me-1"></i>Edytuj
                </a>
                <form asp-action="DeleteMessage" asp-route-id="@message.Id" method="post"
                      data-mod-only data-confirm="Czy na pewno usunąć tę wiadomość? Ta operacja jest nieodwracalna."
                      style="display:none">
                    <button type="submit" class="btn btn-outline-danger btn-xs">
                        <i class="bi bi-trash3 me-1"></i>Usuń
                    </button>
                </form>
            </span>
        </div>
    </article>
}

@if (Model.Messages.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-chat-square-text"></i>
        Brak odpowiedzi — dodaj pierwszą.
    </div>
}
else
{
    <partial name="_Pagination" model="pager" />
}

@* --- Formularz odpowiedzi (edytor inline) ------------------------------ *@
<section class="reply-editor mt-4" id="reply">
    <div class="section-head">
        <h2 class="section-title" style="font-size:1.05rem">Dodaj odpowiedź</h2>
        <span class="reply-hint" data-auth-show="guest">
            Wymagane <a asp-controller="Account" asp-action="Login">logowanie</a>.
        </span>
    </div>

    <form asp-action="Reply" method="post" id="replyForm" data-thread-id="@Model.Id">
        <input type="hidden" asp-for="Reply.ThreadId" />
        <input type="hidden" asp-for="Reply.AuthorName" data-author-name />

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="mb-3">
            <textarea asp-for="Reply.Content" class="form-control" rows="5"
                      placeholder="Napisz odpowiedź..."></textarea>
            <span asp-validation-for="Reply.Content" class="text-validation"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <span class="reply-hint">
                <i class="bi bi-info-circle me-1"></i>Minimalnie 2 znaki. Treść wątku widoczna wyżej.
            </span>
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-send me-1"></i>Wyślij odpowiedź
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/forum.js" asp-append-version="true"></script>
}
