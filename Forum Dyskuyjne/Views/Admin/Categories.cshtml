@model CategoriesAdminViewModel
@{
    ViewData["Title"] = "Kategorie — panel administracyjny";
    ViewData["AdminTab"] = "categories";
    var editing = Model.Form.Id > 0;
}

<div class="section-head">
    <div>
        <h1 class="section-title">Kategorie forów</h1>
        <p class="section-sub">
            Kategoria grupuje fora (każde forum należy do dokładnie jednej kategorii) i jest dostępna
            jako etykieta wątku nadawana przy jego tworzeniu — jedną na wątek, ukrytą na liście,
            używaną do filtrowania w wyszukiwarce.
        </p>
    </div>
</div>

<partial name="_AdminTabs" />

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-site" role="alert">
        <i class="bi bi-check-circle me-1"></i>@successMessage
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-site" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@errorMessage
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="admin-table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nazwa</th>
                        <th>Kolejność</th>
                        <th>Fora</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        var forumCount = Model.ForumsByCategory.TryGetValue(category.Id, out var count) ? count : 0;
                        <tr>
                            <td>
                                <div class="fw-semibold">@category.Name</div>
                                @if (!string.IsNullOrEmpty(category.Description))
                                {
                                    <div class="meta-line">@category.Description</div>
                                }
                            </td>
                            <td>@category.Position</td>
                            <td>@forumCount</td>
                            <td class="text-end">
                                <a class="btn btn-outline-accent btn-xs" asp-action="Categories" asp-route-edit="@category.Id">
                                    <i class="bi bi-pencil me-1"></i>Edytuj
                                </a>
                                <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post"
                                      class="d-inline" data-confirm="Usunąć kategorię «@category.Name»? Można to zrobić tylko wtedy, gdy nie zawiera forów.">
                                    <button type="submit" class="btn btn-outline-danger btn-xs">
                                        <i class="bi bi-trash3 me-1"></i>Usuń
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <section class="settings-section">
            <h3>
                <i class="bi bi-folder-plus"></i>
                @(editing ? "Edycja kategorii" : "Nowa kategoria")
            </h3>

            <form asp-action="SaveCategory" method="post">
                <input type="hidden" asp-for="Form.Id" />

                <div class="mb-3">
                    <label asp-for="Form.Name" class="form-label"></label>
                    <input asp-for="Form.Name" class="form-control" placeholder="np. Technika" />
                    <span asp-validation-for="Form.Name" class="text-validation"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.Description" class="form-label"></label>
                    <textarea asp-for="Form.Description" class="form-control" rows="3"
                              placeholder="Krótki opis kategorii (opcjonalny)"></textarea>
                    <span asp-validation-for="Form.Description" class="text-validation"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Form.Position" class="form-label"></label>
                    <input asp-for="Form.Position" type="number" min="0" max="999" class="form-control" />
                    <span asp-validation-for="Form.Position" class="text-validation"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    @if (editing)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Categories">Anuluj</a>
                    }
                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-check-lg me-1"></i>
                        @(editing ? "Zapisz zmiany" : "Dodaj kategorię")
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
