@*
    Topbar powielany w każdym widoku przez _Layout.
    Widoczność elementów steruje auth.js na podstawie atrybutów:
      data-auth-show="guest"  — widoczne, gdy użytkownik niezalogowany
      data-auth-show="user"   — widoczne dla każdego zalogowanego
      data-auth-show="admin"  — widoczne wyłącznie dla administratora
    Stan aktywnej pozycji nawigacji: ViewData["ActiveNav"] = home | forum
*@
@{
    var activeNav = ViewData["ActiveNav"]?.ToString();
}
<nav class="navbar navbar-expand-lg forum-topbar sticky-top">
    <div class="container">
        @* Nazwa forum pełni rolę przycisku powrotu do strony głównej — osobny link nie jest potrzebny. *@
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"
           aria-label="Strona główna forum" title="Strona główna">
            <span class="brand-mark">FD</span>
            <span class="brand-text">Forum Dyskusyjne</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topbarContent"
                aria-controls="topbarContent" aria-expanded="false" aria-label="Przełącz nawigację">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topbarContent">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(activeNav == "forum" ? "active" : "")"
                       asp-controller="Forum" asp-action="Index">
                        <i class="bi bi-chat-left-text me-1 d-none d-lg-inline"></i>Wątki
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-lg-1">
                @* --- Wybór motywu (3 skórki) --- *@
                <li class="nav-item dropdown">
                    <a class="nav-link nav-icon-link" href="#" role="button" data-bs-toggle="dropdown"
                       aria-expanded="false" title="Wybierz motyw interfejsu">
                        <i class="bi bi-palette-fill"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end theme-dropdown">
                        <li><h6 class="dropdown-header">Motyw interfejsu</h6></li>
                        <li>
                            <a class="dropdown-item" href="#" data-theme-set="light">
                                <span class="theme-swatch swatch-light" aria-hidden="true"></span>Klasyczny
                                <i class="bi bi-check-lg ms-auto theme-check"></i>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#" data-theme-set="dark">
                                <span class="theme-swatch swatch-dark" aria-hidden="true"></span>Ciemny
                                <i class="bi bi-check-lg ms-auto theme-check"></i>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#" data-theme-set="ocean">
                                <span class="theme-swatch swatch-ocean" aria-hidden="true"></span>Ocean
                                <i class="bi bi-check-lg ms-auto theme-check"></i>
                            </a>
                        </li>
                    </ul>
                </li>

                @* --- Panel gościa --- *@
                <li class="nav-item" data-auth-show="guest">
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Zaloguj się</a>
                </li>
                <li class="nav-item ms-lg-1" data-auth-show="guest">
                    <a class="btn btn-accent btn-sm px-3" asp-controller="Account" asp-action="Register">Zarejestruj się</a>
                </li>

                @* --- Panel zalogowanego (avatar, profil, ustawienia, wylogowanie) --- *@
                <li class="nav-item dropdown ms-lg-1" data-auth-show="user">
                    <a class="nav-link dropdown-toggle user-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar" data-auth-avatar aria-hidden="true"></span>
                        <span class="user-name" data-auth-username></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end user-dropdown">
                        <li>
                            <h6 class="dropdown-header text-truncate">
                                Zalogowano jako <span data-auth-username></span>
                            </h6>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person me-2"></i>Profil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Settings">
                                <i class="bi bi-gear me-2"></i>Ustawienia
                            </a>
                        </li>
                        <li data-auth-show="admin">
                            <a class="dropdown-item admin-entry" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock me-2"></i>Panel administracyjny
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" href="#" data-logout>
                                <i class="bi bi-box-arrow-right me-2"></i>Wyloguj
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>
