@model ErrorViewModel
@{
    ViewData["Title"] = "Błąd";
}

<div class="form-card text-center">
    <div class="mb-3" style="font-size: 2.4rem; color: var(--accent)">
        <i class="bi bi-exclamation-octagon"></i>
    </div>
    <h1 class="form-title">Wystąpił błąd</h1>
    <p class="form-subtitle">
        Przy przetwarzaniu żądania pojawił się nieoczekiwany problem. Spróbuj ponownie
        lub wróć na stronę główną.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="meta-line">
            Identyfikator żądania: <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-accent mt-2" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house-door me-1"></i>Strona główna
    </a>
</div>
